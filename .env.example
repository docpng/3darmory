# Copy this file to .env and fill in the values.

# Port the web server listens on
PORT=3000

# Public URL of the site (used for Stripe redirect URLs and product images)
BASE_URL=http://localhost:3000

# Long random string used to sign session cookies (required in production)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Admin (CMS) login
ADMIN_EMAIL=owner@3darmory.com
ADMIN_PASSWORD=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — https://dashboard.stripe.com/webhooks (or `stripe listen`)
STRIPE_WEBHOOK_SECRET=whsec_...

# Three-letter ISO currency code used for all prices
CURRENCY=usd

# Comma-separated list of countries you ship to (ISO 3166-1 alpha-2)
SHIPPING_COUNTRIES=US,CA

# Where the database and uploaded images are stored (use a persistent disk in production)
DATA_DIR=./data

# Set to "false" to start with an empty catalogue instead of demo products
SEED_DEMO_DATA=true
