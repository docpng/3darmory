{
  "name": "3darmory",
  "version": "1.0.0",
  "description": "3D Armory — online store for 3D printed models, figures and trinkets, with an admin CMS and Stripe checkout. Runs on Cloudflare Workers.",
  "scripts": {
    "build": "node scripts/build-views.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "wrangler d1 execute DB --local --file seed/demo.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file seed/demo.sql",
    "setup": "npm run db:migrate:local && npm run db:seed:local",
    "test": "npm run build && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docpng/3darmory.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/docpng/3darmory/issues"
  },
  "homepage": "https://github.com/docpng/3darmory#readme",
  "dependencies": {
    "hono": "^4.13.13",
    "stripe": "^23.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "ejs": "^7.0.1",
    "vitest": "4.1.11",
    "wrangler": "^4.147.0",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "vite": "^7.3.6"
  },
  "type": "module"
}
